import java.util.Scanner;

public class Main {

    // Utility function to print array
    static void printArray(int[] a) {
        for (int x : a) {
            System.out.print(x + " ");
        }
        System.out.println();
    }

    // Partition with step printing
    static int partition(int[] a, int lb, int ub) {
        int pivot = a[lb];
        int start = lb;
        int end = ub;

        System.out.println("\nPartitioning from index " + lb + " to " + ub);
        System.out.println("Pivot = " + pivot);
        printArray(a);

        while (start < end) {

            while (a[start] <= pivot && start < ub) {
                start++;
            }

            while (a[end] > pivot) {
                end--;
            }

            if (start < end) {
                System.out.println("Swap a[" + start + "] = " + a[start] +
                                   " and a[" + end + "] = " + a[end]);

                int temp = a[start];
                a[start] = a[end];
                a[end] = temp;

                printArray(a);
            }
        }

        System.out.println("Swap pivot " + a[lb] + " with a[" + end + "] = " + a[end]);

        int temp = a[lb];
        a[lb] = a[end];
        a[end] = temp;

        printArray(a);

        System.out.println("Pivot placed at index " + end);
        return end;
    }

    // Quick Sort with trace
    static void quickSort(int[] a, int lb, int ub) {
        if (lb < ub) {
            System.out.println("\nQuickSort called on range [" + lb + ", " + ub + "]");
            int loc = partition(a, lb, ub);
            quickSort(a, lb, loc - 1);
            quickSort(a, loc + 1, ub);
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of elements: ");
        int n = sc.nextInt();

        int[] a = new int[n];

        System.out.println("Enter elements:");
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        System.out.println("\nInitial Array:");
        printArray(a);

        quickSort(a, 0, n - 1);

        System.out.println("\nFinal Sorted Array:");
        printArray(a);

        sc.close();
    }
}

